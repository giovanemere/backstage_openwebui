### Distribución por Namespace

{% set namespaces = {} %}
{% for entity in entities %}
  {% set ns = entity.metadata.namespace or "default" %}
  {% if ns not in namespaces %}
    {% set _ = namespaces.update({ns: {'total': 0, 'with_conversations': 0}}) %}
  {% endif %}
  {% set _ = namespaces[ns].update({'total': namespaces[ns]['total'] + 1}) %}
  {% set entity_ref = kind + ":" + ns + "/" + entity.metadata.name %}
  {% if entity_ref in sessions_by_entity %}
    {% set _ = namespaces[ns].update({'with_conversations': namespaces[ns]['with_conversations'] + 1}) %}
  {% endif %}
{% endfor %}

| Namespace | Total {{ kind }}s | Con Conversaciones | Cobertura |
|-----------|{{ "-" * (kind|length + 1) }}|-------------------|-----------|
{% for ns, stats in namespaces.items()|sort %}
{% set coverage = (stats.with_conversations / stats.total * 100) if stats.total > 0 else 0 %}
| {{ ns }} | {{ stats.total }} | {{ stats.with_conversations }} | {{ "%.1f"|format(coverage) }}% |
{% endfor %}

