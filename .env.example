HEALTH_CHECK_ENABLED=true

# Liveness probe
LIVENESS_PROBE_INITIAL_DELAY=60
LIVENESS_PROBE_PERIOD=30
LIVENESS_PROBE_TIMEOUT=10
LIVENESS_PROBE_FAILURE_THRESHOLD=3

# Readiness probe
READINESS_PROBE_INITIAL_DELAY=30
READINESS_PROBE_PERIOD=10
READINESS_PROBE_TIMEOUT=5
READINESS_PROBE_FAILURE_THRESHOLD=3

# =============================================================================
# CONFIGURACIÓN DE DEMO MINIKUBE
# =============================================================================

# Configuración específica para demo en Minikube
DEMO_MINIKUBE_OPTIMIZED=true
DEMO_MINIKUBE_RESOURCE_PROFILE=minimal
DEMO_MINIKUBE_FEATURES=chat,proxy,auth
DEMO_MINIKUBE_TOTAL_MEMORY=1.4Gi
DEMO_MINIKUBE_TOTAL_CPU=1.3
DEMO_MINIKUBE_SETUP_TIME=5min
DEMO_MINIKUBE_VERSION=0.1.0
# =============================================================================
# CONFIGURACIÓN DE CHARTS HELM
# =============================================================================

# Versiones de los charts
BACKSTAGE_CHART_VERSION=0.1.0
OPENWEBUI_CHART_VERSION=0.1.0
POSTGRESQL_CHART_VERSION=0.1.0
DEMO_CHART_VERSION=0.1.0

# Versiones de las aplicaciones
BACKSTAGE_APP_VERSION=1.20.0
OPENWEBUI_APP_VERSION=0.1.124
POSTGRESQL_APP_VERSION=15.0
DEMO_APP_VERSION=1.0.0

# Información de mantenedores
CHART_MAINTAINER_NAME=Amazon Q
CHART_MAINTAINER_EMAIL=demo@example.com

# URLs del proyecto
CHART_HOME_URL=https://github.com/edissonz8809/iaops
CHART_SOURCE_URL=https://github.com/edissonz8809/iaops

# Configuración de dependencias
POSTGRESQL_DEPENDENCY_ENABLED=postgresql.enabled
BACKSTAGE_DEPENDENCY_ENABLED=backstage.enabled
OPENWEBUI_DEPENDENCY_ENABLED=openwebui.enabled

# Categorías de charts
BACKSTAGE_CHART_CATEGORY=Developer Tools
OPENWEBUI_CHART_CATEGORY=AI Tools
POSTGRESQL_CHART_CATEGORY=Database

# Keywords para charts
BACKSTAGE_KEYWORDS=backstage,developer-portal,openwebui,chat,demo
OPENWEBUI_KEYWORDS=openwebui,ai,chat,llm,backstage,demo
POSTGRESQL_KEYWORDS=postgresql,database,backstage,openwebui,demo
DEMO_KEYWORDS=backstage,openwebui,developer-portal,ai,chat,demo,minikube

# Features específicas de cada chart
BACKSTAGE_CHART_FEATURES=chat-integration,proxy-enabled,basic-auth
OPENWEBUI_CHART_FEATURES=backstage-integration,shared-database
POSTGRESQL_CHART_FEATURES=shared-database,optimized-config
DEMO_CHART_FEATURES=chat-integration,shared-database,proxy-enabled

# Componentes del demo
DEMO_CHART_COMPONENTS=postgresql,backstage,openwebui
# Configuración adicional para Minikube
DEMO_MINIKUBE_OPTIMIZED=true

# Límites específicos por componente (ya definidos arriba pero agrupados aquí)
# Estos valores se usan en las anotaciones de los Chart.yaml
BACKSTAGE_MEMORY_LIMIT=512Mi
BACKSTAGE_CPU_LIMIT=500m
OPENWEBUI_MEMORY_LIMIT=512Mi
OPENWEBUI_CPU_LIMIT=500m
POSTGRES_MEMORY_LIMIT=256Mi
POSTGRES_CPU_LIMIT=200m

# Configuración total del demo
DEMO_MINIKUBE_TOTAL_MEMORY=1.4Gi
DEMO_MINIKUBE_TOTAL_CPU=1.3
