# Backstage + OpenWebUI Demo - Environment Variables Template
# Copiar este archivo a .env y configurar los valores apropiados

# =============================================================================
# CONFIGURACIÓN GENERAL
# =============================================================================

# Entorno de ejecución (development, demo, production)
NODE_ENV=demo

# Namespace de Kubernetes
KUBERNETES_NAMESPACE=default

# Registry de Docker
DOCKER_REGISTRY=edissonz8809/iaops

# Títulos y nombres de aplicación
BACKSTAGE_APP_TITLE=Backstage + OpenWebUI Demo
OPENWEBUI_APP_NAME=OpenWebUI Demo

# Configuración de proxy
PROXY_TARGET_OPENWEBUI=http://openwebui:8080
PROXY_PATH_REWRITE_OPENWEBUI=^/api/openwebui
PROXY_FORWARDED_PROTO=http
PROXY_FORWARDED_HOST=backstage.local

# Configuración de ingress annotations
INGRESS_REWRITE_TARGET=/
INGRESS_PROXY_BODY_SIZE=50m
INGRESS_CORS_ALLOW_ORIGIN=*

# Configuración de storage
STORAGE_CLASS_NAME=""
STORAGE_ACCESS_MODE=ReadWriteOnce
BACKSTAGE_STORAGE_SIZE=1Gi
OPENWEBUI_STORAGE_SIZE=2Gi
POSTGRESQL_STORAGE_SIZE=2Gi

# Configuración de annotations
DEMO_MINIKUBE_OPTIMIZED=true
DEMO_MINIKUBE_RESOURCE_PROFILE=standard
DEMO_MINIKUBE_FEATURES=chat,proxy,auth
DEMO_MINIKUBE_TOTAL_MEMORY=1.4Gi
DEMO_MINIKUBE_TOTAL_CPU=1.3
DEMO_MINIKUBE_SETUP_TIME=5min
DEMO_MINIKUBE_VERSION=0.1.0

# =============================================================================
# CONFIGURACIÓN DE MINIKUBE
# =============================================================================

# Recursos asignados a Minikube
MINIKUBE_MEMORY=4096
MINIKUBE_CPUS=2
MINIKUBE_DISK_SIZE=20g

# =============================================================================
# CONFIGURACIÓN DE BACKSTAGE
# =============================================================================

# URL base de Backstage
BACKSTAGE_BASE_URL=http://localhost:3000
BACKSTAGE_BACKEND_BASE_URL=http://localhost:7007

# Puerto de Backstage
BACKSTAGE_PORT=3000
BACKSTAGE_BACKEND_PORT=7007

# Configuración de autenticación básica
BACKSTAGE_AUTH_ENABLED=true
BACKSTAGE_AUTH_SECRET=demo-secret-key-change-in-production

# GitHub integration (opcional para demo)
GITHUB_TOKEN=your-github-token-here
GITHUB_ORG=your-github-org

# Configuración de health checks
BACKSTAGE_HEALTH_CHECK_PATH=/healthcheck

# Configuración de secretos
BACKSTAGE_SECRETS_NAME=backstage-secrets

# =============================================================================
# CONFIGURACIÓN DE OPENWEBUI
# =============================================================================

# URL base de OpenWebUI
OPENWEBUI_BASE_URL=http://localhost:8080

# Puerto de OpenWebUI
OPENWEBUI_PORT=8080

# Configuración de modelos de IA
OPENWEBUI_DEFAULT_MODEL=gpt-3.5-turbo
OPENWEBUI_API_KEY=your-openai-api-key-here

# Configuración de chat
OPENWEBUI_MAX_TOKENS=2048
OPENWEBUI_TEMPERATURE=0.7

# Configuración de usuarios y signup
OPENWEBUI_ENABLE_SIGNUP=true
OPENWEBUI_DEFAULT_USER_ROLE=user
OPENWEBUI_ENABLE_LOGIN_FORM=true

# Configuración de health checks
OPENWEBUI_HEALTH_CHECK_PATH=/health

# Configuración de secretos
OPENWEBUI_SECRETS_NAME=openwebui-secrets

# Configuración de persistencia
OPENWEBUI_PERSISTENCE_MOUNT_PATH=/app/backend/data

# =============================================================================
# CONFIGURACIÓN DE BASE DE DATOS
# =============================================================================

# PostgreSQL configuración
POSTGRES_HOST=postgresql-service
POSTGRES_PORT=5432
POSTGRES_DB=backstage_openwebui
POSTGRES_USER=postgres
POSTGRES_PASSWORD=demo-password-change-in-production

# Configuración específica de PostgreSQL
POSTGRES_INITDB_ARGS=--encoding=UTF8 --lc-collate=C --lc-ctype=C
POSTGRES_HOST_AUTH_METHOD=md5
POSTGRES_SHARED_PRELOAD_LIBRARIES=pg_stat_statements
POSTGRES_MULTIPLE_DATABASES=backstage,openwebui
POSTGRES_DATA_DIR=/var/lib/postgresql/data/pgdata

# URLs de conexión
DATABASE_URL=postgresql://postgres:demo-password-change-in-production@postgresql-service:5432/backstage_openwebui
BACKSTAGE_DATABASE_URL=postgresql://postgres:demo-password-change-in-production@postgresql-service:5432/backstage_openwebui
OPENWEBUI_DATABASE_URL=postgresql://postgres:demo-password-change-in-production@postgresql-service:5432/backstage_openwebui

# Configuración de base de datos para charts
DATABASE_CLIENT=pg
DATABASE_SSL_REQUIRE=false

# =============================================================================
# CONFIGURACIÓN DE REDIS (OPCIONAL)
# =============================================================================

# Redis configuración (solo si está habilitado)
REDIS_ENABLED=false
REDIS_HOST=redis-service
REDIS_PORT=6379
REDIS_PASSWORD=demo-redis-password

# URL de conexión Redis
REDIS_URL=redis://:demo-redis-password@redis-service:6379

# =============================================================================
# CONFIGURACIÓN DE MKDOCS
# =============================================================================

# Puerto de MkDocs
MKDOCS_PORT=8000

# Configuración de documentación
DOCS_SITE_NAME=Backstage OpenWebUI Docs
DOCS_SITE_URL=http://localhost:8000

# =============================================================================
# CONFIGURACIÓN DE JENKINS (OPCIONAL)
# =============================================================================

# Jenkins configuración (solo si está habilitado)
JENKINS_ENABLED=false
JENKINS_PORT=8081
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=demo-jenkins-password

# =============================================================================
# CONFIGURACIÓN DE MONITOREO (OPCIONAL)
# =============================================================================

# Prometheus (solo si está habilitado)
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# Grafana (solo si está habilitado)
GRAFANA_ENABLED=false
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=demo-grafana-password

# =============================================================================
# CONFIGURACIÓN DE RECURSOS KUBERNETES
# =============================================================================

# Límites de recursos para Backstage
BACKSTAGE_MEMORY_REQUEST=256Mi
BACKSTAGE_MEMORY_LIMIT=512Mi
BACKSTAGE_CPU_REQUEST=200m
BACKSTAGE_CPU_LIMIT=500m

# Límites de recursos para OpenWebUI
OPENWEBUI_MEMORY_REQUEST=256Mi
OPENWEBUI_MEMORY_LIMIT=512Mi
OPENWEBUI_CPU_REQUEST=200m
OPENWEBUI_CPU_LIMIT=500m

# Límites de recursos para PostgreSQL
POSTGRES_MEMORY_REQUEST=128Mi
POSTGRES_MEMORY_LIMIT=256Mi
POSTGRES_CPU_REQUEST=100m
POSTGRES_CPU_LIMIT=200m

# Límites de recursos para MkDocs
MKDOCS_MEMORY_REQUEST=64Mi
MKDOCS_MEMORY_LIMIT=128Mi
MKDOCS_CPU_REQUEST=50m
MKDOCS_CPU_LIMIT=100m

# =============================================================================
# CONFIGURACIÓN DE DESARROLLO
# =============================================================================

# Modo debug
DEBUG=true

# Hot reload habilitado
HOT_RELOAD=true

# Logs detallados
LOG_LEVEL=debug

# =============================================================================
# CONFIGURACIÓN DE SEGURIDAD
# =============================================================================

# Claves de encriptación (cambiar en producción)
ENCRYPTION_KEY=demo-encryption-key-32-characters
JWT_SECRET=demo-jwt-secret-key

# CORS configuración
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

# =============================================================================
# CONFIGURACIÓN DE INTEGRACIÓN
# =============================================================================

# Webhook para integración chat-docs
WEBHOOK_SECRET=demo-webhook-secret

# Configuración de proxy
PROXY_TIMEOUT=30000

# Token de integración entre servicios
INTEGRATION_TOKEN=demo-integration-token

# =============================================================================
# CONFIGURACIÓN DE HELM CHARTS
# =============================================================================

# Registry y tags de imágenes Docker
BACKSTAGE_IMAGE_REGISTRY=edissonz8809
BACKSTAGE_IMAGE_REPOSITORY=iaops/backstage
BACKSTAGE_IMAGE_TAG=demo-latest

OPENWEBUI_IMAGE_REGISTRY=edissonz8809
OPENWEBUI_IMAGE_REPOSITORY=iaops/openwebui
OPENWEBUI_IMAGE_TAG=demo-latest

POSTGRESQL_IMAGE_REGISTRY=docker.io
POSTGRESQL_IMAGE_REPOSITORY=postgres
POSTGRESQL_IMAGE_TAG=15-alpine

# Configuración de Ingress
INGRESS_CLASS_NAME=nginx
INGRESS_DOMAIN=local
INGRESS_TLS_ENABLED=false

# Hosts de Ingress
BACKSTAGE_HOST=backstage.local
OPENWEBUI_HOST=openwebui.local

# =============================================================================
# CONFIGURACIÓN DE USUARIOS DEMO
# =============================================================================

# Usuarios de Backstage
BACKSTAGE_DEMO_USER=demo
BACKSTAGE_DEMO_PASSWORD=demo123
BACKSTAGE_ADMIN_USER=admin
BACKSTAGE_ADMIN_PASSWORD=admin123

# Usuarios de OpenWebUI
OPENWEBUI_DEMO_USER=demo
OPENWEBUI_DEMO_PASSWORD=demo123
OPENWEBUI_REGULAR_USER=user
OPENWEBUI_REGULAR_PASSWORD=user123

# =============================================================================
# CONFIGURACIÓN DE PLUGINS BACKSTAGE
# =============================================================================

# Plugin de Chat
CHAT_PLUGIN_ENABLED=true
CHAT_PLUGIN_TITLE=AI Chat Assistant
CHAT_PLUGIN_DESCRIPTION=Chat with AI directly from Backstage

# Plugin de TechDocs
TECHDOCS_ENABLED=true
TECHDOCS_BUILDER=mkdocs
TECHDOCS_GENERATOR=techdocs
TECHDOCS_PUBLISHER_TYPE=local

# Plugin de Catálogo
CATALOG_ENABLED=true
CATALOG_RULES=Component,System,API,Resource,Location,User,Group

# Plugin de Scaffolder
SCAFFOLDER_ENABLED=true
SCAFFOLDER_DEFAULT_AUTHOR_NAME=Backstage Demo
SCAFFOLDER_DEFAULT_AUTHOR_EMAIL=demo@backstage.local

# =============================================================================
# CONFIGURACIÓN DE OPENAI
# =============================================================================

# API Key de OpenAI (configurar con valor real)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=2048
OPENAI_TEMPERATURE=0.7

# =============================================================================
# CONFIGURACIÓN DE ANTHROPIC
# =============================================================================

# API Key de Anthropic (opcional)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_ENABLED=false

# =============================================================================
# CONFIGURACIÓN DE OLLAMA
# =============================================================================

# Configuración de Ollama (opcional)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://ollama:11434

# =============================================================================
# CONFIGURACIÓN DE BACKUP
# =============================================================================

# Configuración de backup automático
BACKUP_ENABLED=false
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=7

# =============================================================================
# CONFIGURACIÓN DE HEALTH CHECKS
# =============================================================================

# Configuración de health checks
HEALTH_CHECK_ENABLED=true
LIVENESS_PROBE_INITIAL_DELAY=60
LIVENESS_PROBE_PERIOD=30
LIVENESS_PROBE_TIMEOUT=10
LIVENESS_PROBE_FAILURE_THRESHOLD=3

READINESS_PROBE_INITIAL_DELAY=30
READINESS_PROBE_PERIOD=10
READINESS_PROBE_TIMEOUT=5
READINESS_PROBE_FAILURE_THRESHOLD=3

# =============================================================================
# CONFIGURACIÓN DE SISTEMA
# =============================================================================

# Configuración de sistema prompt para OpenWebUI
SYSTEM_PROMPT=You are a helpful AI assistant integrated with Backstage developer portal.

# Configuración de CORS
CORS_ENABLED=true
CORS_ALLOW_CREDENTIALS=true

# Configuración de sesiones
SESSION_SECRET=demo-session-secret
SESSION_MAX_AGE=86400000

# Configuración de rate limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# NOTAS IMPORTANTES
# =============================================================================

# 1. Este archivo contiene configuraciones para DEMO únicamente
# 2. Para producción, cambiar todas las contraseñas y secretos
# 3. No commitear archivos .env con valores reales
# 4. Usar Kubernetes Secrets para valores sensibles en producción
# 5. Las configuraciones opcionales pueden deshabilitarse para ahorrar recursos

